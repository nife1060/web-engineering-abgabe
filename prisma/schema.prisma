// Dies ist deine Prisma-Schema-Datei,
// mehr dazu in der Dokumentation: https://pris.ly/d/prisma-schema

// Kostenlose gehostete Postgres-Datenbank in Sekunden erstellen: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

enum Role {
  ADMIN
  CREATOR
  USER
}

enum CourseStatus {
  DRAFT
  PUBLISHED
}

enum LessonType {
  VIDEO
  TEXT
  QUIZ
}

enum MediaType {
  VIDEO
  IMAGE
  PDF
  AUDIO
  TEXT
  OTHER
}

enum PricingModel {
  PAID
  FREE
  SUBSCRIPTION
}

enum OrderStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum EnrollmentSource {
  PURCHASE
  SUBSCRIPTION
  FREE
  ADMIN_GRANT
}

model User {
  id               String   @id @default(cuid())
  name             String
  email            String   @unique
  password         String
  role             Role     @default(USER)
  createdAt        DateTime @default(now())
  stripeCustomerId String?  @unique
  courses          Course[]
  progress         Progress[]
  wishlist         Wishlist[]
  uploads          Media[]
  enrollments      Enrollment[]
  orders           Order[]
  subscriptions    Subscription[]
  certificates     Certificate[]
}

model Category {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
  courses   Course[]
}

model Course {
  id            String       @id @default(cuid())
  title         String
  description   String
  categoryId    String?
  categoryName  String
  level         String       @default("Beginner")
  language      String       @default("English")
  pricingModel  PricingModel @default(PAID)
  price         Float        @default(0)
  subscriptionPrice Float    @default(0)
  thumbnailUrl  String?
  promoVideoUrl String?
  status        CourseStatus @default(DRAFT)
  creatorId     String
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  category Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  creator  User      @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  modules  Module[]
  wishlistedBy  Wishlist[]
  enrollments   Enrollment[]
  orders        Order[]
  subscriptions Subscription[]
  certificates  Certificate[]

  @@index([creatorId])
  @@index([status])
}

model Module {
  id       String   @id @default(cuid())
  title    String
  order    Int
  courseId String

  course  Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons Lesson[]

  @@index([courseId])
}

model Lesson {
  id       String     @id @default(cuid())
  title    String
  content  String     @default("")
  type     LessonType @default(VIDEO)
  videoUrl String?
  order    Int
  moduleId String

  module    Module     @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  progress  Progress[]
  media     Media[]
  questions Question[]

  @@index([moduleId])
}

model Question {
  id       String   @id @default(cuid())
  text     String
  order    Int
  lessonId String

  lesson  Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  answers Answer[]

  @@index([lessonId])
}

model Answer {
  id         String   @id @default(cuid())
  text       String
  isCorrect  Boolean  @default(false)
  order      Int
  questionId String

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([questionId])
}

model Media {
  id           String    @id @default(cuid())
  filename     String
  storedName   String
  url          String
  mimeType     String
  size         Int
  type         MediaType @default(OTHER)
  lessonId     String?
  uploadedById String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  lesson     Lesson? @relation(fields: [lessonId], references: [id], onDelete: SetNull)
  uploadedBy User    @relation(fields: [uploadedById], references: [id], onDelete: Cascade)

  @@index([lessonId])
  @@index([uploadedById])
}

model Progress {
  id          String    @id @default(cuid())
  userId      String
  lessonId    String
  completed   Boolean   @default(false)
  completedAt DateTime?

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
  @@index([lessonId])
}

model Wishlist {
  id        String   @id @default(cuid())
  userId    String
  courseId  String
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@index([courseId])
}

model Enrollment {
  id        String           @id @default(cuid())
  userId    String
  courseId  String
  source    EnrollmentSource
  active    Boolean          @default(true)
  createdAt DateTime         @default(now())
  expiresAt DateTime?

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@index([userId])
  @@index([courseId])
}

model Order {
  id                    String      @id @default(cuid())
  userId                String
  courseId              String
  amount                Float
  currency              String      @default("eur")
  status                OrderStatus @default(PENDING)
  stripeSessionId       String?     @unique
  stripePaymentIntentId String?
  stripeInvoiceId       String?
  hostedInvoiceUrl      String?
  receiptUrl            String?
  createdAt             DateTime    @default(now())
  paidAt                DateTime?

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([stripeSessionId])
}

model Certificate {
  id        String   @id @default(cuid())
  serial    String   @unique
  userId    String
  courseId  String
  issuedAt  DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@index([userId])
  @@index([courseId])
}

model Subscription {
  id                   String   @id @default(cuid())
  userId               String
  courseId             String
  stripeSubscriptionId String   @unique
  stripeCustomerId     String
  status               String
  currentPeriodEnd     DateTime
  cancelAtPeriodEnd    Boolean  @default(false)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([courseId])
}
