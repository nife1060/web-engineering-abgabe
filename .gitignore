# Mehr zum Ignorieren von Dateien unter https://help.github.com/articles/ignoring-files/

# Abhängigkeiten
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Tests
/coverage

# next.js
/.next/
/out/

# Produktion
/build

# Sonstiges
.DS_Store
*.pem
dev.db
dev.db-journal
public/uploads/*
!public/uploads/.gitkeep

# Debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
dev-*.log

# Env-Dateien (können bei Bedarf eingecheckt werden)
.env
.env.local
env.local
.env.development.local
.env.test.local
.env.production.local
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Lokale Claude-Code-Einstellungen
.claude/settings.local.json

/src/generated/prisma

# Gemeinsam genutzte SQLite-Datenbank des Projekts
!dev.db
node_modules/
.next/

node_modules/
.next/

